function notifyUser_(userId,title,message,type) { append_('Notifications',{notificationId:'N-' + new Date().getTime() + '-' + Math.floor(Math.random()*1000),userId:userId,title:title,message:message,type:type || 'info',read:false,createdAt:nowIso_()}); }
function getNotifications_(p) { const user = requireAuth_(p); return ok_(rows_('Notifications').filter(function(x){return x.userId === user.userId;}).sort(function(a,b){return new Date(b.createdAt)-new Date(a.createdAt);}).slice(0,30)); }
function markNotificationRead_(p) { const user = requireAuth_(p); const n = findOne_('Notifications','notificationId',p.notificationId); if (!n || n.userId !== user.userId) throw new Error('Notifikasi tidak ditemukan.'); updateByField_('Notifications','notificationId',p.notificationId,{read:true}); return ok_(null,'Notifikasi ditandai sudah dibaca.'); }
